# Discord OAuth para `yarn supabase:start` (lido pelo config.toml).
# Redirect no Discord Developer Portal: http://127.0.0.1:54321/auth/v1/callback
# Preencha com o Client ID e o Client Secret — não invente valores.
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=

# Google OAuth. Redirect: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
