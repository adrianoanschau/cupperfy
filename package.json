{
  "name": "cupperfy",
  "private": true,
  "description": "Monorepo Cupperfy — plataforma de gestão de competições (MVP x1 futebol e-sports)",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @cupperfy/web dev",
    "build": "yarn workspace @cupperfy/web build",
    "lint": "yarn workspace @cupperfy/web lint",
    "format": "yarn workspace @cupperfy/web format",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "supabase": "^2.76.15"
  },
  "engines": {
    "node": ">=20"
  }
}
