# NEXT_PUBLIC_SUPABASE_URL e keys
# Local: copie de `yarn supabase:status` (na raiz).
# Produção/Preview: configure as mesmas chaves no dashboard Vercel
#   (ver docs/08-deploy-vercel.md). No app use apps/web/.env.local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direto (GUI / psql) — só local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
