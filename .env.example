# NEXT_PUBLIC_SUPABASE_URL e keys
# Local: copie de `yarn supabase:status` (na raiz).
# Produção/Preview: configure as mesmas chaves no dashboard Vercel
#   (ver docs/08-deploy-vercel.md). No app use apps/web/.env.local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direto (GUI / psql) — só local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Chat (Gemini direto — só servidor)
GOOGLE_GENERATIVE_AI_API_KEY=

# Handoff humano (públicos)
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/adrianoanschau
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/adrianoanschau
NEXT_PUBLIC_SUPPORT_EMAIL=contato@cupperfy.com

# Redes oficiais (opcional — já há default da marca)
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@Cupperfy
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cupperfy

# Apoio / PIX (página /apoiadores) — cole o “copia e cola” estático do banco
NEXT_PUBLIC_PIX_PAYLOAD=
NEXT_PUBLIC_PIX_KEY_LABEL=
NEXT_PUBLIC_PIX_BENEFICIARY=Cupperfy / Adriano Anschau

# Admin (/admin) — senha local + segredo da sessão (mín. 32 chars)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# E-mail de convite
# Local (Mailpit do Supabase): veja em http://127.0.0.1:54324
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
EMAIL_FROM=Cupperfy <noreply@cupperfy.local>
# Produção (Resend, domínio cupperfy.com verificado) — deixe SMTP_HOST vazio e use:
RESEND_API_KEY=
# EMAIL_FROM=Cupperfy <contato@cupperfy.com>
EMAIL_REPLY_TO=contato@cupperfy.com
NEXT_PUBLIC_APP_URL=http://cupperfy.localhost
# Produção: NEXT_PUBLIC_APP_URL=https://cupperfy.com

# Discord OAuth (Supabase Auth). Crie um app em https://discord.com/developers/applications
# Redirect no Discord: http://127.0.0.1:54321/auth/v1/callback
# O CLI local lê estas vars (coloque também em supabase/.env se o start não herdar o ambiente).
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=

# Google OAuth (Supabase Auth). Credenciais Web em https://console.cloud.google.com/apis/credentials
# Redirect: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
